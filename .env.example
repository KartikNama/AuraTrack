# AuraTrack Environment Configuration

# Supabase API Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Storage & Screenshot Server URL
# Configure this to your screenshot / file storage endpoint (e.g. https://storage.yourdomain.com)
VITE_STORAGE_BASE_URL=https://storage.auratrack.io

# Base Path (Optional - default is '/')
# VITE_BASE_PATH=/
